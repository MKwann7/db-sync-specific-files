# Dropbox OAuth app credentials. Create an app at https://www.dropbox.com/developers/apps
# and copy its App key / App secret here. Never commit this file (it is
# gitignored) and never share these values.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Obtained once via `dbsync auth login` (see README.md). Required for
# unattended operation; dbsync uses it to automatically mint short-lived
# access tokens, so this is the only secret the running service needs.
DROPBOX_REFRESH_TOKEN=

# Path inside the container to the YAML configuration file. The default
# compose.yaml mounts ./config/config.yaml to this path.
DBSYNC_CONFIG=/app/config.yaml
